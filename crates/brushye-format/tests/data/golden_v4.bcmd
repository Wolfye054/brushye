doc.new 300 200 paper=#f0e8d8
layer.new L1 name="Base"
layer.fill L1 color=#3060a0
layer.new L2 name="Ink"
select.ellipse x=40 y=30 w=120 h=90
brush.stroke L2 color=#000000 size=30 samples=[10,80,1,0;290,90,1,20000]
select.none
select.rect x=150 y=20 w=100 h=150
select.polygon points=[20,180;120,120;140,190] aa=none mode=add
select.rect x=200 y=60 w=20 h=20 mode=subtract
